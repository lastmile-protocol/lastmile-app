{
  "name": "lastmile-app",
  "version": "0.1.0",
  "private": true,
  "description": "An offline-first Stellar wallet. The wallet itself has no dependencies and loads nothing from the network; these are for the relayer and the tests.",
  "scripts": {
    "test": "node uitest.cjs && node qrtest.mjs",
    "serve": "node -e \"require('http').createServer((q,s)=>require('fs').createReadStream('.'+(q.url==='/'?'/index.html':q.url)).on('error',()=>s.writeHead(404).end()).pipe(s)).listen(8899,()=>console.log('http://localhost:8899'))\""
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "playwright": "^1.63.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "dependencies": {
    "@lastmile/sdk": "github:lastmile-protocol/lastmile-sdk"
  },
  "type": "module"
}
